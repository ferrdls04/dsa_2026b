"""
escribir un programa que calcule
la suma de los "n" numeros naturales.
por ejemplo si n=100, el programa
calcular la suma del 1 al 100
42
"""

# importamos biblioteca time 
import time 

# funcion que suma los 
# primeros "n" numeros naturales
def sum_of_n(n):
      total_sum = 0
      number = 1
      
      # sumando los "n" numeros
      # ciclo while
      while number <= n:
           total_sum = total_sum + number
           number = number + 1
      
      return total_sum

# variablel para guardar 
# El data set
dataset = [] 

# Generado el contenido del Datset
repetition = 1

while repetition <= 10:
    # tomo el tiempo 1 (inicio)
    timestamp_01 = time.time()

    # sumo los "n" números
    n = repetition * 500
    result = sum_of_n(n)

    # tomando el tiempo final 
    timestamp_02 = time.time()
    
    # Calculo el tiempo
    elapsed_time = round((timestamp_02-timestamp_01) * 1e6, 2)

    # Agregar la tripleta de los datos al dataset
    # datos al dataset
    dataset.append((n,elapsed_time, result))

    repetition = repetition + 1

# imprimir el dataset
position = 0

while position < len(dataset):
    print(dataset[position])
    position = position + 1
